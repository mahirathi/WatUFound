<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_feed">

    <fragment
        android:id="@+id/navigation_feed"
        android:name="com.ece452.watufound.ui.home.HomeFragment"
        android:label="Feed"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_post"
        android:name="com.ece452.watufound.ui.post.PostContainerFragment"
        android:label="Post"
        tools:layout="@layout/fragment_post_container" />

    <fragment
        android:id="@+id/navigation_messages"
        android:name="com.ece452.watufound.ui.messages.ConversationsFragment"
        android:label="Messages"
        tools:layout="@layout/fragment_conversations" />

    <fragment
        android:id="@+id/navigation_conversation"
        android:name="com.ece452.watufound.ui.messages.ConversationFragment"
        android:label="Conversation"
        tools:layout="@layout/fragment_conversation">
        <argument
            android:name="otherUserId"
            app:argType="string" />
        <argument
            android:name="otherUserName"
            app:argType="string" />
        <argument
            android:name="conversationId"
            app:argType="string" />
        <argument
            android:name="postTitle"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.ece452.watufound.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/navigation_update_profile"
        android:name="com.ece452.watufound.ui.profile.UpdateProfileFragment"
        android:label="Update Profile"
        tools:layout="@layout/fragment_update_profile" />

    <fragment
        android:id="@+id/navigation_post_details"
        android:name="com.ece452.watufound.ui.post.PostDetailsFragment"
        android:label="Post Details"
        tools:layout="@layout/fragment_post_details" />

    <!-- Admin Navigation -->
    <fragment
        android:id="@+id/navigation_admin_dashboard"
        android:name="com.ece452.watufound.ui.admin.AdminDashboardFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_dashboard" />

    <fragment
        android:id="@+id/navigation_admin_users"
        android:name="com.ece452.watufound.ui.admin.AdminUsersFragment"
        android:label="User Management"
        tools:layout="@layout/fragment_admin_users" />

    <fragment
        android:id="@+id/navigation_admin_posts"
        android:name="com.ece452.watufound.ui.admin.AdminPostsFragment"
        android:label="Post Management"
        tools:layout="@layout/fragment_admin_posts" />

    <fragment
        android:id="@+id/navigation_admin_reports"
        android:name="com.ece452.watufound.ui.admin.AdminReportsFragment"
        android:label="Reports Management"
        tools:layout="@layout/fragment_admin_reports" />

    <fragment
        android:id="@+id/navigation_admin_analytics"
        android:name="com.ece452.watufound.ui.admin.AdminAnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_admin_analytics" />

    <fragment
        android:id="@+id/navigation_admin_settings"
        android:name="com.ece452.watufound.ui.admin.AdminSettingsFragment"
        android:label="System Settings"
        tools:layout="@layout/fragment_admin_settings" />



</navigation>