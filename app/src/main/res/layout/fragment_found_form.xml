<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_500"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Card container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:elevation="8dp"
            android:padding="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:clipToPadding="false"
            android:layout_gravity="center">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report Found Item"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help others reclaim their lost items"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp" />

            <!-- Item Title -->
            <TextView
                style="@style/TextLabel"
                android:text="Item Title" />

            <EditText
                android:id="@+id/itemTitleInput"
                style="@style/InputField" />

            <!-- Description -->
            <TextView
                style="@style/TextLabel"
                android:text="Description" />

            <EditText
                android:id="@+id/descriptionInput"
                style="@style/InputField"
                android:layout_height="52dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3" />

            <!-- Category -->
            <TextView
                style="@style/TextLabel"
                android:text="Category" />

            <Spinner
                android:id="@+id/categorySpinner"
                style="@style/SpinnerField" />

            <!-- Found At -->
            <TextView
                style="@style/TextLabel"
                android:text="Found At" />

            <AutoCompleteTextView
                android:id="@+id/foundAtInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select location"
                android:inputType="text"
                android:background="@drawable/input_field_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:dropDownHeight="200dp"
                android:completionThreshold="1" />

            <!-- Date & Time Found -->
            <TextView
                style="@style/TextLabel"
                android:text="Date and Time Found" />

            <EditText
                android:id="@+id/dateTimeInput"
                style="@style/InputField"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

            <!-- Post as Anonymous Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">
                <Switch
                    android:id="@+id/switch_anonymous"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_marginEnd="12dp" />
                <TextView
                    style="@style/TextLabel"
                    android:text="Post as Anonymous"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp" />
            </LinearLayout>

            <!-- Submit Button -->
            <Button
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Post Found Item"
                android:backgroundTint="@color/purple_500"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:layout_marginTop="24dp"
                android:padding="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
