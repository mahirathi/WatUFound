<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Card container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:clipToPadding="false"
            android:layout_gravity="center">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report Found Item"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help others reclaim their lost items"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp" />

            <!-- Item Title -->
            <TextView
                style="@style/TextLabel"
                android:text="Item Title" />

            <EditText
                android:id="@+id/itemTitleInput"
                style="@style/InputField" />

            <!-- Description -->
            <TextView
                style="@style/TextLabel"
                android:text="Description" />

            <EditText
                android:id="@+id/descriptionInput"
                style="@style/InputField"
                android:layout_height="52dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3" />
            <TextView
                android:id="@+id/noticeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/notice_background"
                android:autoLink="web"
                android:text="@string/notice_high_value_item_deposition"
                android:textColor="@color/blue"
                android:padding="12dp"
                android:textSize="14sp"/>
            <!-- Category -->
            <TextView
                style="@style/TextLabel"
                android:text="Category" />

            <Spinner
                android:id="@+id/categorySpinner"
                style="@style/SpinnerField" />

            <!-- Found At -->
            <TextView
                style="@style/TextLabel"
                android:text="Found At" />

            <AutoCompleteTextView
                android:id="@+id/foundAtInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="eg: Engineering 7 (E7)"
                android:inputType="text"
                android:background="@drawable/input_field_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:dropDownHeight="200dp"
                android:completionThreshold="1" />

            <!-- Room Number -->
            <TextView
                style="@style/TextLabel"
                android:text="Room Number" />

            <EditText
                android:id="@+id/roomNumberInput"
                style="@style/InputField"
                android:hint="e.g: E7-4452"
                android:inputType="text"
                android:layout_marginBottom="16dp" />


            <!-- Map Preview -->
            <com.google.android.gms.maps.MapView
                android:id="@+id/mapViewPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- Date & Time Found -->
            <TextView
                style="@style/TextLabel"
                android:text="Date and Time Found" />

            <EditText
                android:id="@+id/dateTimeInput"
                style="@style/InputField"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />


            <!-- Image Upload Preview -->
            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground"
                android:background="@drawable/rounded_card_background"
                android:contentDescription="Image preview" />

            <!-- Image Upload Button -->
            <Button
                android:id="@+id/buttonSelectImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload Image"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/purple_500"
                android:textColor="@android:color/white" />

            <!-- Post as Anonymous Switch -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">
                <Switch
                    android:id="@+id/switch_anonymous"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_marginEnd="12dp"
                    android:theme="@style/PurpleSwitchTheme" />
                <TextView
                    style="@style/TextLabel"
                    android:text="Post anonymously"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp" />
            </LinearLayout>

            <!-- Submit Button -->
            <Button
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Post Found Item"
                android:backgroundTint="@color/purple_500"
                android:textColor="@android:color/white"
                android:textAllCaps="true"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="30dp"
                android:padding="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
