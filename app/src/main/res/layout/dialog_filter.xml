<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/feed_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Filter Posts"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/tab_text_selected" />

            <ImageButton
                android:id="@+id/buttonClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Close"
                android:rotation="180"
                app:tint="@color/tab_text_selected" />

        </LinearLayout>

        <!-- Date & Time Range Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date and Time Posted"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/tab_text_selected"
                android:layout_marginBottom="16dp" />

            <!-- Start Date & Time -->
            <TextView
                style="@style/TextLabel"
                android:text="Start" />

            <EditText
                android:id="@+id/editTextStartDateTime"
                style="@style/InputField"
                android:hint="Select start date and time"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

            <!-- End Date & Time -->
            <TextView
                style="@style/TextLabel"
                android:text="End" />

            <EditText
                android:id="@+id/editTextEndDateTime"
                style="@style/InputField"
                android:hint="Select end date and time"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

        </LinearLayout>

        <!-- Category Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/tab_text_selected"
                android:layout_marginBottom="16dp" />

            <!-- Dynamic category checkboxes container -->
            <LinearLayout
                android:id="@+id/categoryCheckboxesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

            <!-- Select All Categories Button -->
            <Button
                android:id="@+id/buttonSelectAllCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select All Categories"
                android:textSize="15sp"
                android:backgroundTint="@color/off_white"
                android:textColor="@color/tab_text_selected"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/buttonClearFilters"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Clear All"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/off_white"
                android:textColor="@color/tab_text_selected"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonApplyFilters"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Apply Filters"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/tab_text_selected"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView> 